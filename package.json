{
  "name": "mitchlui-dev",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "start": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --outDir build/client",
    "lint": "eslint .",
    "prepare": "husky",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build",
    "test": "react-router build && vitest run --project unit --project node",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^7.18.5",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@react-router/dev": "^7.18.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-storybook": "^10.6.7",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "neostandard": "^0.14.1",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "nano-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
