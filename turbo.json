{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "^transit"],
      "outputs": ["build/**"]
    },
    "build-storybook": {
      "dependsOn": ["^transit"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["build", "^transit"]
    }
  }
}
